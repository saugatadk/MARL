# ------------------------------------------------------------------------------
# 2. Reinforcement Learning Training Logs & Intermediates
# ------------------------------------------------------------------------------
# TensorBoard logs and run-time metrics
phase1_single_agent/training/logs/**/events.out.tfevents.*
phase1_single_agent/training/logs/**/monitor.csv
*.tfevents.*
monitor.csv

# Intermediate training checkpoints (step checkpoints e.g., *_ckpt_*_steps.zip)
phase1_single_agent/training/checkpoints/*_ckpt_*_steps.zip
**/checkpoints/*_ckpt_*_steps.zip

# Note: Final evaluated models (dqn_paschimanchal.zip, ppo_paschimanchal.zip)
# are kept tracked (~780 KB total) so evaluation and demo scripts run out-of-the-box.
# To ignore all model weights instead, uncomment the line below:
# *.zip


# Route alternatives generated dynamically by duarouter
*.rou.alt.xml

# Output & tripinfo metrics from simulation runs
*tripinfo*.xml
*emission*.xml
*summary*.xml
*queue*.xml
*netstate*.xml
*.sumo.log
*.sumo.dump
*.vehroute.xml

